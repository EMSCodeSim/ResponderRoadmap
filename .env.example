DATABASE_URL="postgresql://user:password@host:5432/responderroadmap?sslmode=require"
# Optional Neon unpooled URI for Prisma migrations (same value as DATABASE_URL is fine for a direct host)
# DIRECT_URL="postgresql://user:password@host:5432/responderroadmap?sslmode=require"
AUTH_SECRET="generate-a-long-random-secret"
NEXT_PUBLIC_APP_NAME="ResponderRoadmap"
# Local disposable databases only. Never enable on production.
NEXT_PUBLIC_DEMO_LOGIN="false"
