/// Reusable building blocks that can be copied into a new Training Sheet.
model TrainingSheetComponentTemplate {
  id           String     @id @default(cuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  kind         String     // GRADING or EMS_CE_LIST
  name         String
  dataJson     String     @default("{}")
  archived     Boolean    @default(false)
  revision     Int        @default(1)
  createdById  String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([departmentId, kind, name])
  @@index([departmentId, kind, archived])
}

/// Department-owned reusable skills checklists, managed independently from Task Books.
model SkillChecklist {
  id           String     @id @default(cuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  title        String
  description  String     @default("")
  sectionsJson String     @default("[]")
  status       String     @default("DRAFT")
  revision     Int        @default(1)
  archived     Boolean    @default(false)
  backingVersionId String? @unique
  backingVersion TaskBookVersion? @relation("SkillChecklistBackingVersion", fields: [backingVersionId], references: [id], onDelete: SetNull)
  createdById  String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([departmentId, title])
  @@index([departmentId, status, archived])
}

/// A scheduled class or skills-testing event using a published checklist.
model TrainingClass {
  id                     String          @id @default(cuid())
  departmentId           String
  department             Department      @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  title                  String
  classType              String          @default("GENERAL")
  /// Simple reporting category for training-hour exports; not an ISO rules engine.
  trainingCategory       String          @default("COMPANY")
  /// Credit awarded to each PRESENT department member when the class is COMPLETE.
  creditHours            Float           @default(0)
  /// Per-category EMS CE hours retained with the training record.
  ceCreditsJson          String          @default("[]")
  /// Template grading options copied at creation time.
  gradingConfigJson      String          @default("{}")
  templateName           String          @default("")
  templateRevision       Int?
  checklistVersionId     String
  checklistVersion       TaskBookVersion @relation(fields: [checklistVersionId], references: [id])
  startsAt               DateTime
  endsAt                 DateTime?
  location               String          @default("")
  /// Structured station/apparatus location used by department training reports.
  station                String          @default("")
  /// Department shift or platoon responsible for the training record.
  shift                  String          @default("")
  status                 String          @default("DRAFT")
  rmsStatus              String          @default("NOT_READY")
  instructorApprovedAt   DateTime?
  instructorApprovedById String?
  rmsEnteredAt           DateTime?
  rmsEnteredById         String?
  rmsReference           String?
  rmsEntryNote           String          @default("")
  registrationToken      String?         @unique
  registrationEnabled    Boolean         @default(false)
  customFieldsJson       String          @default("[]")
  notes                  String          @default("")
  createdById            String
  createdBy              User            @relation("ClassCreator", fields: [createdById], references: [id])
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  roster   TrainingClassEnrollment[]
  proctors TrainingClassProctor[]
  stations TrainingClassStation[]

  @@index([departmentId, startsAt])
}

model TrainingClassProctor {
  id         String        @id @default(cuid())
  classId    String
  class      TrainingClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt DateTime      @default(now())

  @@unique([classId, userId])
  @@index([userId, classId])
}

model TrainingClassStation {
  id String @id @default(cuid())
  classId String
  class TrainingClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  checklistVersionId String
  checklistVersion TaskBookVersion @relation(fields: [checklistVersionId], references: [id], onDelete: Restrict)
  title String
  proctorUserId String?
  proctor User? @relation("ClassStationProctor", fields: [proctorUserId], references: [id], onDelete: SetNull)
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([classId, checklistVersionId])
  @@index([proctorUserId])
}

model TrainingClassEnrollment {
  id                String                @id @default(cuid())
  classId           String
  class             TrainingClass         @relation(fields: [classId], references: [id], onDelete: Cascade)
  membershipId      String?
  membership        DepartmentMembership? @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  guestName         String?
  guestEmail        String?
  guestOrganization String?
  attendance        String                @default("REGISTERED")
  writtenScore      Float?
  customValuesJson  String                @default("{}")
  ccfScore          Float?
  finalResult       String                @default("PENDING")
  notes             String                @default("")
  enrolledAt        DateTime              @default(now())
  completedAt       DateTime?

  skillResults TrainingClassSkillResult[]

  @@unique([classId, membershipId])
  @@unique([classId, guestEmail])
  @@index([membershipId, classId])
}

/// Latest result per student and skill. Every change is also written to AuditLog.
model TrainingClassSkillResult {
  id              String                  @id @default(cuid())
  enrollmentId    String
  enrollment      TrainingClassEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  requirementId   String
  requirement     TaskBookRequirement     @relation(fields: [requirementId], references: [id])
  result          String                  @default("NOT_EVALUATED")
  notes           String                  @default("")
  numericScore    Float?
  stepResultsJson String                  @default("[]")
  evaluatorId     String
  evaluator       User                    @relation("ClassEvaluator", fields: [evaluatorId], references: [id])
  evaluatedAt     DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@unique([enrollmentId, requirementId])
  @@index([evaluatorId, evaluatedAt])
}

/// Department-scoped, explicitly approved cross-template evidence matching.
/// This never signs off a Task Book requirement or changes its completion status.
model SkillEvidenceEquivalency {
  id                  String   @id @default(cuid())
  departmentId        String
  sourceRequirementId String
  targetRequirementId String
  reason              String
  approvedById        String
  approvedAt          DateTime @default(now())
  revokedAt           DateTime?
  revokedById         String?
  createdAt           DateTime @default(now())

  @@unique([departmentId, sourceRequirementId, targetRequirementId])
  @@index([departmentId, targetRequirementId, revokedAt])
}

/// Short-lived counters for abuse protection. Keys are one-way hashes, never raw IP addresses.
model RegistrationRateLimit {
  key         String   @id
  windowStart DateTime
  count       Int      @default(1)
  updatedAt   DateTime @updatedAt

  @@index([windowStart])
}

model WebSignInRequest {
  id                String    @id @default(cuid())
  approvalTokenHash String    @unique
  browserSecretHash String    @unique
  approvedUserId    String?
  status            String    @default("PENDING")
  createdAt         DateTime  @default(now())
  expiresAt         DateTime
  approvedAt        DateTime?
  consumedAt        DateTime?

  @@index([status, expiresAt])
  @@index([approvedUserId, status])
}

/// Department-managed credential. Distinct from PersonalCredential.
model Credential {
  id                 String               @id @default(cuid())
  membershipId       String
  membership         DepartmentMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  departmentId       String
  department         Department           @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  credentialTypeId   String?
  credentialType     CredentialType?      @relation(fields: [credentialTypeId], references: [id])
  credentialName     String
  issuer             String               @default("")
  credentialNumber   String?
  issueDate          DateTime?
  expirationDate     DateTime?
  doesNotExpire      Boolean              @default(false)
  verificationStatus String
  attachmentUrl      String?
  notes              String               @default("")
  source             String               @default("DEPARTMENT")
  sourceExternalId   String?
  sourceUpdatedAt    DateTime?
  sharedByMemberAt   DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@unique([membershipId, source, sourceExternalId])
  @@index([departmentId, expirationDate])
  @@index([membershipId])
}

model ActivityEvent {
  id           String     @id @default(cuid())
  userId       String?
  user         User?      @relation(fields: [userId], references: [id])
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  type         String
  referenceId  String?
  timestamp    DateTime   @default(now())
  metadataJson String     @default("{}")

  @@index([departmentId, timestamp])
}

model AuditLog {
  id           String     @id @default(cuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  actorId      String
  actor        User       @relation("AuditActor", fields: [actorId], references: [id])
  action       String
  entityType   String
  entityId     String
  timestamp    DateTime   @default(now())
  detailsJson  String     @default("{}")

  @@index([departmentId, timestamp])
}

/// Short-lived recovery snapshots for eligible cleanup actions.
model TrainingRecoveryItem {
  id           String     @id @default(cuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  entityType   String
  entityId     String
  title        String
  snapshotJson String
  deletedAt    DateTime   @default(now())
  expiresAt    DateTime

  @@index([departmentId, expiresAt])
}

/// Durable, per-user assignment inbox. Reading an item never deletes it.
model InboxNotification {
  id              String     @id @default(cuid())
  departmentId    String
  department      Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            String
  title           String
  body            String
  referenceType   String?
  referenceId     String?
  actionPath      String?
  dedupeKey       String?
  createdAt       DateTime   @default(now())
  readAt          DateTime?
  pushStatus      String     @default("PENDING")
  pushAttemptedAt DateTime?
  pushError       String?

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
  @@index([departmentId, createdAt])
}

/// FCM registration tokens. A token is moved to the latest authenticated user.
model PushDevice {
  id           String     @id @default(cuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String     @unique
  platform     String
  enabled      Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  lastSeenAt   DateTime   @default(now())

  @@index([userId, enabled])
  @@index([departmentId, enabled])
}

/// Personal Career Road credential. Never returned by department-scoped APIs.
model PersonalCredential {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  issuer         String    @default("")
  issueDate      DateTime?
  expirationDate DateTime?
  notes          String    @default("")
  createdAt      DateTime  @default(now())
}

/// Personal Career Road log entry. Never returned by department-scoped APIs.
model PersonalCareerLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  detail     String   @default("")
  occurredAt DateTime
  createdAt  DateTime @default(now())
}

/// Public department interest form records. Kept in Prisma's schema so db push preserves the table.
model DepartmentInterest {
  id             String   @id
  name           String
  email          String
  departmentName String
  role           String
  memberCount    Int
  buyingIntent   String
  comments       String   @default("")
  consent        Boolean  @default(true)
  consentAt      DateTime @db.Timestamp(3)
  source         String   @default("department-interest")
  status         String   @default("NEW")
  notes          String   @default("")
  createdAt      DateTime @default(now()) @db.Timestamp(3)
  updatedAt      DateTime @default(now()) @db.Timestamp(3)

  @@index([status], map: "DepartmentInterest_status_idx")
  @@index([email], map: "DepartmentInterest_email_idx")
}

/// Department-defined operational authorization such as Engine Driver, Medic Driver, Interior Firefighter, or Acting Officer.
model OperationalRole {
  id                      String                           @id @default(cuid())
  departmentId            String
  department              Department                       @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  name                    String
  category                String                           @default("OPERATIONS")
  description             String                           @default("")
  credentialTypeIdsJson   String                           @default("[]")
  taskBookTemplateIdsJson String                           @default("[]")
  requirementIdsJson      String                           @default("[]")
  manualApprovalRequired  Boolean                          @default(true)
  archived                Boolean                          @default(false)
  createdById             String
  createdAt               DateTime                         @default(now())
  updatedAt               DateTime                         @updatedAt
  authorizations          MemberOperationalAuthorization[]

  @@unique([departmentId, name])
  @@index([departmentId, archived])
}

/// Explicit department authorization. Certificates/training never silently create an APPROVED authorization.
model MemberOperationalAuthorization {
  id           String               @id @default(cuid())
  departmentId String
  department   Department           @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  membershipId String
  membership   DepartmentMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  roleId       String
  role         OperationalRole      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  status       String               @default("NOT_STARTED")
  restriction  String               @default("")
  note         String               @default("")
  approvedById String?
  approvedAt   DateTime?
  reviewDate   DateTime?
  updatedById  String
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@unique([membershipId, roleId])
  @@index([departmentId, roleId, status])
  @@index([membershipId, status])
}

/// Per-user mobile notification preferences. In-app operational notices remain authoritative even when push is disabled.
model NotificationPreference {
  id                   String     @id @default(cuid())
  departmentId         String
  department           Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  userId               String
  user                 User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialExpiryPush Boolean    @default(true)
  assignmentPush       Boolean    @default(true)
  evaluationPush       Boolean    @default(true)
  dueDatePush          Boolean    @default(true)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  @@unique([departmentId, userId])
}
